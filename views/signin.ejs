<%- include('partials/header', { title: title }) %>

<%# tabindex="-1" so focus can start on the heading when we arrived here
    because something happened, rather than because the user chose to. %>
<h1 tabindex="-1" <%= arrivalMessage ? 'data-autofocus' : '' %>>Sign in</h1>

<% if (arrivalMessage) { %>
  <p class="status" data-tone="info"><%= arrivalMessage %></p>
<% } %>

<p>
  Sign in to the <%= siteName %> with your passkey. There is no password to
  type.
</p>

<!--
  Accessibility rule: say what is about to happen, in text, before the
  operating system's passkey prompt appears.
-->
<div class="prompt-notice">
  <h2>What happens when you sign in</h2>
  <p>
    <strong><%= origin %></strong> will ask <strong>this device</strong>, or a
    security key you plug in, to prove it holds your passkey. Your device will
    check it is you using your fingerprint, your face or your device PIN.
  </p>
</div>

<h2>Choose how to sign in</h2>

<%- include('partials/status') %>

<div class="sign-in-actions">
  <button type="button" id="passkey-button">Sign in with a passkey</button>
  <%# Points at /recover until the "Other ways to sign in" page exists
      (plan step 4); this is the only other route that works today. %>
  <a class="button-link" id="other-method-link" href="/recover">Use another method</a>
  <%# Hidden until plan step 3 adds voice guidance and un-hides it with
      script; a visible control that does nothing yet would trap a
      screen-reader user who activates it expecting something to happen. %>
  <button type="button" id="read-guidance" hidden>Read guidance</button>
</div>

<h2>Sign in with your username instead</h2>
<form id="signin-form" novalidate>
  <div class="field">
    <label for="username">Username</label>
    <p class="hint" id="username-hint">
      Use this if your passkey is on a security key or another device.
    </p>
    <input
      type="text"
      id="username"
      name="username"
      autocomplete="username webauthn"
      aria-describedby="username-hint"
      autocapitalize="none"
      spellcheck="false"
      required
    />
  </div>
  <p><button type="submit" id="submit">Continue</button></p>
</form>

<p>No account yet? <a href="/register">Create an account</a>.</p>

<%- include('partials/footer', { scripts: ['/js/signin-messages.js', '/js/signin.js'] }) %>
